# Copy to .env and fill in every required value before running.

# ---------- Required: deployment secrets ----------
# At least 32 random characters each. Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
MANAGEMENT_TOKEN=changeme
ACTUATOR_TOKEN=changeme

# ---------- Detection mode ----------
# observe            Log only; no classification or containment.
# agent              Classify with Jev (optional) then investigate and respond with an LLM.
# classifier-contain Classify with Jev; provisional 15-min ban on a malicious verdict. No LLM.
# inline             Classify with Jev before forwarding; block on a malicious verdict.
BASTION_MODE=observe

# ---------- LLM provider (agent mode) ----------
# DeepSeek takes precedence. With neither key, agent mode is unavailable.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=

BLUE_MODEL=claude-sonnet-4-5
RED_MODEL=claude-opus-4-5

# ---------- Jev classifier (required for classifier-contain and inline) ----------
TYPESAFE_API_KEY=
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
MALICIOUS_THRESHOLD=0.5
# Inline classifier failure policy: reject (503) or allow (forward).
INLINE_FAILURE=reject

# ---------- Capacity controls ----------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=10
RATE_LIMIT_ENABLED=1
CLASSIFIER_TIMEOUT=5
CLASSIFIER_CONCURRENCY=8
MODEL_CALLS_PER_MINUTE=120
QUEUE_LIMIT=10000
MAX_REQUEST_BYTES=65536
MAX_RESPONSE_BYTES=2097152

# ---------- Source attribution ----------
# 1: Trust the first X-Forwarded-For hop as the source identity.
#    Required for the local lab so attacker IP spoof works; DO NOT enable in production.
#    In production set TRUSTED_PROXY_CIDRS to your load-balancer CIDRs instead.
DEMO_IDENTITY=1
TRUSTED_PROXY_CIDRS=

# ---------- Destructive remediation ----------
# 1: Permits kill_process, rotate_secret, quarantine_container, patch_vuln etc. via the
#    actuator, AND lets the agent trigger them without per-action operator approval.
#    Required in the local lab for end-to-end remediation; review before production.
ALLOW_DESTRUCTIVE=1

# ---------- Operator approval tokens (one-time actions from the dashboard) ----------
# Generated automatically; never stored in .env. Rotated when used.

# ---------- Email (Resend when keyed; local fallback otherwise) ----------
# Leave RESEND_API_KEY blank for a local demo: alerts still fire, written to
# data/local_mail.jsonl and the mail-worker container logs instead of being sent.
# Store a newly generated key in .env only; never commit real credentials.
RESEND_API_KEY=
ALERT_FROM="Bastion Alerts <alerts@bastion0.dev>"
ALERT_TO=your-real-email@example.com
# Multiple recipients: comma-separated. Sender must belong to a verified domain.
# Without a domain: onboarding@resend.dev can only send to your Resend account email.
# Validate without sending: python mail_worker.py --env-file .env --check
# Send one labeled test:    python mail_worker.py --env-file .env --test
# Continuous delivery:     python mail_worker.py --env-file .env
# Failed Resend requests stay pending for retry, or become dead on permanent/max
# failures. The local fallback never fails that way: it just writes the alert.

# ---------- Target app (de-fingerprinted DVWA fork) and red agent ----------
# Internal URL of the vulnerable target. Service name stays `dvwa` (internal-only).
DVWA_URL=http://localhost:80
# Per-deploy mutation seed. Empty => fresh random mutation each container boot.
# Set a value to pin a reproducible instance (paths/params/creds/schema).
BASTION_SEED=
# Target vuln difficulty: low | medium (default medium — exploitable but requires adaptation).
APP_LEVEL=medium
# Legacy: only used by the still-DVWA-shaped blue remediation/bootstrap tools
# (bootstrap_dvwa.py, remediation_tools.py). NOT the target's credentials — those are
# non-default, randomized per deploy and discoverable in-app. See MUTATION.md.
DVWA_USER=admin
DVWA_PASSWORD=password
PROXY_URL=http://localhost:8080
ATTACKER_IP=10.13.37.7

# ---------- Data ----------
RETENTION_DAYS=30
# Captured stdout/stderr lines per Compose service (1–10000), max 4096 chars each.
LOG_RETENTION_LINES=1000
