# Copy to .env and fill in. The system-2 agent runs on EITHER provider:
#   - DEEPSEEK_API_KEY  -> routes the agent through DeepSeek's Anthropic-compatible
#                          endpoint (cheap; same Messages API, no code change). Wins if set.
#   - ANTHROPIC_API_KEY -> native Claude.
# With neither, the blue agent still defends via Jev system-1 autoblock.
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat   # or deepseek-reasoner
ANTHROPIC_API_KEY=

DVWA_URL=http://localhost:80
PROXY_URL=http://localhost:8080
ATTACKER_IP=10.13.37.7

BLUE_MODEL=claude-sonnet-5
RED_MODEL=claude-opus-5

# Email. Defaults target MailHog (no auth) so the demo never flakes.
# For REAL email set a real server + app-password creds (e.g. Gmail: smtp.gmail.com / 587).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ALERT_TO=soc@yourteam.com
ALERT_FROM=blue-agent@breach-agent.local

# System-1 classifier (TypeSafe Jev). Without this key the blue agent falls back
# to the regex pre-filter alone.
TYPESAFE_API_KEY=
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
MALICIOUS_THRESHOLD=0.5
USE_JEV=1
USE_REGEX_PREGATE=1
JEV_AUTOBLOCK=1   # Jev verdict drives the WAF directly (no Claude needed)
