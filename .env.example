# Copy to .env and fill in every required value before running.

# ---------- Required: deployment secrets ----------
# At least 32 random characters each. Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
MANAGEMENT_TOKEN=changeme
ACTUATOR_TOKEN=changeme

# ---------- Detection mode ----------
# observe            Log only; no classification or containment.
# agent              Classify with Jev (optional) then investigate and respond with an LLM.
# classifier-contain Classify with Jev; provisional 15-min ban on a malicious verdict. No LLM.
# inline             Classify with Jev before forwarding; block on a malicious verdict.
BASTION_MODE=observe

# ---------- LLM provider (agent mode) ----------
# DeepSeek takes precedence. With neither key, agent mode is unavailable.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=

BLUE_MODEL=claude-sonnet-4-5
RED_MODEL=claude-opus-4-5

# ---------- Jev classifier (required for classifier-contain and inline) ----------
TYPESAFE_API_KEY=
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
MALICIOUS_THRESHOLD=0.5
USE_JEV=1

# ---------- Autoblock reflex (optional, agent mode only) ----------
# 0: Jev flags, the LLM decides all enforcement (default).
# 1: A very-high-confidence flag also triggers a reversible honeypot diversion
#    while the LLM investigates. Has no effect without a valid LLM key.
JEV_AUTOBLOCK=0
AUTOBLOCK_HIGH=0.9
AUTOBLOCK_TTL_MIN=15

# ---------- Capacity controls ----------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=10
RATE_LIMIT_ENABLED=1
CLASSIFIER_TIMEOUT=5
CLASSIFIER_CONCURRENCY=8
MODEL_CALLS_PER_MINUTE=120
QUEUE_LIMIT=10000
MAX_REQUEST_BYTES=65536
MAX_RESPONSE_BYTES=2097152

# ---------- Source attribution ----------
# demo: Trust X-Forwarded-For unconditionally (DO NOT use outside localhost).
# In production, set TRUSTED_PROXY_CIDRS to the CIDRs of your load balancers.
DEMO_IDENTITY=0
TRUSTED_PROXY_CIDRS=

# ---------- Destructive remediation (off by default) ----------
# 1: Permits kill_process, rotate_secret, quarantine_container, etc. via the actuator.
# These require operator review in real deployments.
ALLOW_DESTRUCTIVE=0

# ---------- Email (defaults target MailHog; no auth required) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ALERT_FROM=bastion@localhost
ALERT_TO=soc@example.com

# ---------- DVWA and red agent ----------
DVWA_URL=http://localhost:80
DVWA_USER=admin
DVWA_PASSWORD=password
PROXY_URL=http://localhost:8080
ATTACKER_IP=10.13.37.7

# ---------- Data ----------
RETENTION_DAYS=30
